# Local development overrides for `npm run dev`.
# Copy to .env.development.local (gitignored). Next.js loads it only in dev and
# gives it priority over .env / .env.local, which can keep production values.
# Pairs with src/backend/dev.env (see README, "Local development and tests").

# local MongoDB (users are read here by NextAuth)
MONGODB_URI=mongodb://127.0.0.1:27017/csc
MONGODB_DB=csc
MONGODB_USERCOLLECTION=users

# NextAuth: encrypts the session cookie; any long random value, independent of the
# backend JWT_SECRET (the frontend never verifies the backend token)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=local-development-only

# local FastAPI from `invoke dev-backend`
FASTAPI_URL=http://127.0.0.1:8000

# empty: assets come through the local backend, not the production static host
NEXT_PUBLIC_STATIC_BASE_URL=

BETA_PHASE=0
GH_INTERFACE_DEACTIVATED=0
