# Base URL for static assets (component previews, images, downloads).
# On Uberspace, Next.js runs behind an Apache reverse proxy. Serving large static files
# through that proxy causes 502 timeouts. Setting this to a URL that is served directly
# by Apache (e.g. your ~/html/ directory) bypasses the proxy for asset requests.
# On localhost this variable is ignored and Next.js serves assets as usual.
NEXT_PUBLIC_STATIC_BASE_URL=

# Emergency switch for the Content-Security-Policy: 1 sends the same policy as
# Content-Security-Policy-Report-Only (the browser then only logs violations in
# its console and blocks nothing; framing is still refused by X-Frame-Options).
# Restart the frontend after changing it. Leave unset or 0 in normal operation.
# CSC_CSP_REPORT_ONLY=1

# NEXTAUTH
NEXTAUTH_URL=https://your-public-address.com
NEXTAUTH_SECRET=JWTSecretShouldGoHere

# FASTAPI
FASTAPI_URL=https://your-api.address.com
API_TOKEN_TIMEOUT_MINS=59

# FOR BETA PHASES
BETA_PHASE=1
BETA_BANNER_TEXT="VERSION 0.6.1.0"
BETA_LOGIN_MESSAGE="The Catalog of Second Chances is currently in testing for version 0.6.1.0! You may encounter incomplete features, breaking changes, or data updates. If you do so, please get in touch! Thank you for helping us improve the platform."
GH_INTERFACE_DEACTIVATED=0