# Base URL of PUBLIC UI files under /static/ (optional; leave empty to serve them
# from the app). It never applies to catalogue files (previews, photos, meshes,
# proxies): those are private and come through the authenticated /snapshots/...
# routes of the API (decision 8.125). On localhost this variable is ignored.
NEXT_PUBLIC_STATIC_BASE_URL=

# MONGODB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/yourdatabase?retryWrites=true&w=majority
MONGODB_DB="yourdatabase"
MONGODB_USERCOLLECTION="users"

# NEXTAUTH
NEXTAUTH_URL=https://your-public-address.com
NEXTAUTH_SECRET=JWTSecretShouldGoHere

# FASTAPI
FASTAPI_URL=https://your-api.address.com
API_TOKEN_TIMEOUT_MINS=59

# FOR BETA PHASES (0 or 1)
BETA_PHASE=0
BETA_BANNER_TEXT="BETA 0.5.0.0"BETA_LOGIN_MESSAGE="The Catalog of Second Chances is currently in beta for version 0.5.0.0! You may encounter incomplete features, breaking changes, or data updates. If you do so, please get in touch! Thank you for helping us improve the platform."
GH_INTERFACE_DEACTIVATED=0