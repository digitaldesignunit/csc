# Local development settings for `invoke dev-backend`.
# Copy to dev.env (gitignored) and adjust. Never put production secrets here.
#
# MongoDB: the local MongoDB Community Server service (winget / MSI installs
# it on port 27017). Fill it with `invoke seed --dump 260916`.

MONGODB_URI=mongodb://127.0.0.1:27017/csc
JWT_SECRET=local-development-only
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=600
GITHUB_REPO_URL=https://github.com/digitaldesignunit/csc
SMTP_HOST=localhost
SMTP_USER=dev
SMTP_PASSWORD=dev
SMTP_FROM_EMAIL=noreply@localhost
# prints verification links to the console instead of sending mail
SMTP_DEV_MODE=true
FRONTEND_URL=http://localhost:3000
# self-registration without invitation (comma-separated, subdomains included; decision 8.14)
CSC_OPEN_REGISTRATION_DOMAINS=tu-darmstadt.de
FASTAPI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Asset folders (relative to the repository root). Point SNAPSHOT_*_DIR at a
# copy of the production assets to see meshes, photos and previews locally.
# Example for the asset copy that belongs to dump 260916 (local edits write into it):
#   SNAPSHOT_PREVIEW_DIR=D:/01_PROJECT_WORKDATA/260916_CSC_ASSETS/snapshot_previews
#   SNAPSHOT_PHOTOS_DIR=D:/01_PROJECT_WORKDATA/260916_CSC_ASSETS/snapshot_photos
#   SNAPSHOT_MESHES_DIR=D:/01_PROJECT_WORKDATA/260916_CSC_ASSETS/meshes
#   SNAPSHOT_POINT_CLOUDS_DIR=D:/01_PROJECT_WORKDATA/260916_CSC_ASSETS/pointclouds
SNAPSHOT_PREVIEW_DIR=.dev/assets/snapshot_previews
SNAPSHOT_PHOTOS_DIR=.dev/assets/snapshot_photos
SNAPSHOT_MESHES_DIR=.dev/assets/meshes
SNAPSHOT_POINT_CLOUDS_DIR=.dev/assets/pointclouds
SNAPSHOT_PROXIES_DIR=.dev/assets/proxies
SNAPSHOT_CAPTURE_DIR=.dev/assets/capture
# Where the heavy geometry stages (proxies, descriptors, complexity, previews) run:
# server (default; this machine's cron and the recompute route) or remote
# (only a worker started with `main_geometry.py --remote`; decision 8.54)
# CSC_GEOMETRY_HEAVY_STAGES=server
GH_XML_CACHE_DIR=.dev/ghxml
CLIENT_LOG_PATH=.dev/logs/client_versions.log
# Client header enforcement (decision 8.11); unset = log only. Production sets
# it in the 0.6 cutover deploy, e.g. gh-userobjects=0.6.0.0,web=0.6.0.0
# CSC_MIN_CLIENT_VERSIONS=gh-userobjects=0.6.0.0,web=0.6.0.0
