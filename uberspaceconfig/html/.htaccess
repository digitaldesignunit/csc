# rewrite rules
<IfModule mod_rewrite.c>

# enable awesome urls. i.e.:
# http://yourdomain.com/about-us/team
RewriteEngine On

# make sure to set the RewriteBase correctly
# if you are running the site in a subfolder.
# Otherwise links or the entire site will break.
#
# If your homepage is http://yourdomain.com/mysite
# Set the RewriteBase to:
#
RewriteBase /

# Force download files
<FilesMatch "\.(wsc)$">
    Header set Content-Type application/octet-stream
    Header set Content-Disposition attachment
</FilesMatch>

Header set X-Content-Type-Options "nosniff"

<IfModule mod_headers.c>
  # `Header set` can only name one origin, so reflect a matched origin instead.
  # Keep the legacy host listed while it still redirects to the canonical one.
  SetEnvIf Origin "^(https://(?:2ndchances\.build|www\.2ndchances\.build|ddu\.uber\.space))$" CSC_ALLOWED_ORIGIN=$1
  Header set Access-Control-Allow-Origin "%{CSC_ALLOWED_ORIGIN}e" env=CSC_ALLOWED_ORIGIN
  Header append Vary Origin
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type"
</IfModule>

