# CSC maintenance mode (csc_maintenance.sh): written next to index.html in the
# web domain's own document root; removed again by `csc_maintenance.sh off`.
# Every path answers 503 with the maintenance page and a Retry-After.
ErrorDocument 503 /index.html

<IfModule mod_headers.c>
  Header always set Retry-After "3600"
  Header always set Cache-Control "no-store"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !=/index.html
  RewriteRule ^ - [R=503,L]
</IfModule>
