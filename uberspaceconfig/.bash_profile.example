# .bash_profile

# Get the aliases and functions
if [ -f ~/.bashrc ]; then
        . ~/.bashrc
fi

# User specific environment and startup programs

PATH=$HOME/.local/bin:$HOME/bin:$PATH

export PATH

# ---- CATALOG OF SECOND CHANCES ENVIRONMENT VARS ----------------------------

# MongoDB
export MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@your.cluster.mongodb.net/csc"

# JWT
export JWT_SECRET="your-openssl-rand-hex-32-value"
export JWT_ALGORITHM="HS256"
export JWT_ACCESS_TOKEN_EXPIRE_MINUTES="60"

# GitHub
#     The repo is public: releases (deploys) and /ghinterface/ need no token.
#     GITHUB_CSC_GH_TOKEN is optional and only raises GitHub API rate limits
#     (CSC_Update, csc_release_deploy.sh).
export GITHUB_REPO_URL="https://github.com/your-org/your-repo"
# export GITHUB_CSC_GH_TOKEN="github_pat_xxxxxxxxxxxxxxxxxxxx"

# SMTP / Email
export SMTP_HOST="yourhost.uberspace.de"
export SMTP_PORT="587"
export SMTP_USER="noreply@2ndchances.build"
export SMTP_PASSWORD="your-mailbox-password"
export SMTP_FROM_EMAIL="noreply@2ndchances.build"
export SMTP_FROM_NAME="Catalog of Second Chances"
# where a reply to a verification or password-reset mail goes (the support
# address); the mails themselves are sent from the noreply mailbox. Optional.
export SMTP_REPLY_TO="support@2ndchances.build"
export FRONTEND_URL="https://2ndchances.build"
# the links of the exports (JSON-LD context, PDF passport) name this API
# address; without it they use the request's own, which is http:// behind the
# proxy. Optional.
export CSC_PUBLIC_API_URL="https://api.2ndchances.build"
export CSC_OPEN_REGISTRATION_DOMAINS="tu-darmstadt.de"

# Filesystem paths
# shipped with each release (grasshopper_userobjects_xml)
export GH_XML_CACHE_DIR="/home/ddu/csc/current/backend/static/ghxml"
# the catalogue files are private (decision 8.125): outside the web root, served
# only by the API to the people who may see the piece
export SNAPSHOT_PREVIEW_DIR="/home/ddu/csc_assets_private/snapshot_previews"
export SNAPSHOT_PHOTOS_DIR="/home/ddu/csc_assets_private/snapshot_photos"
export SNAPSHOT_MESHES_DIR="/home/ddu/csc_assets_private/meshes"
export SNAPSHOT_POINT_CLOUDS_DIR="/home/ddu/csc_assets_private/pointclouds"
export SNAPSHOT_PROXIES_DIR="/home/ddu/csc_assets_private/proxies"
export SNAPSHOT_CAPTURE_DIR="/home/ddu/csc_assets_private/capture"
# evidence attachments (lab reports, inspection photos); served only to
# signed-in users through the API
export EVIDENCE_ATTACHMENTS_DIR="/home/ddu/csc_assets_private/evidence"
export EVIDENCE_UPLOAD_LIMIT_MB=25
# where proxies, descriptors, complexity and previews run: server | remote
# (remote = a worker elsewhere, `main_geometry.py --remote`; then this
# server's cron and recompute route do only frame and shape class)
export CSC_GEOMETRY_HEAVY_STAGES="server"

# Snapshot upload limits (optional; defaults in utility.py)
export SNAPSHOT_PHOTO_UPLOAD_LIMIT_MB=10
export SNAPSHOT_PHOTO_MAX_OUTPUT_MB=2
export SNAPSHOT_PHOTO_MAX_LONG_EDGE_PX=4096

# FastAPI 
export FASTAPI_CORS_ORIGINS="http://yourdomain.com,https://yourdomain.com,http://www.yourdomain.com,https://www.yourdomain.com,http://localhost:3000"

# Geometry Upload File Size Limit
export GEOMETRY_UPLOAD_LIMIT_MB="250"