# CSC production crontab. Paste it into `crontab -e` on the server (it replaces
# the whole crontab: see the README in this folder).
#
# One MAILTO line for the whole file: it applies to every line below it. Put
# the maintainer's address in the server's crontab only, never in this
# repository. Output of the jobs goes to the logs, so cron mails only when a
# line fails before its redirect (e.g. when `source` fails).
MAILTO="<maintainer email>"

# Logs: every job appends to its own file of the day, <job>_cronjob.<YYYY-MM-DD>.log
# (the % is escaped, cron would read it as a line break), and the last line
# of this file deletes the files older than 14 days (the privacy page promises
# that no log is kept longer). deploy.<date>.log is written by csc_deploy_gate.sh.

# The heavy jobs share one lock, /home/ddu/csc/shared/locks/heavy.lock (the
# folder is made once: mkdir -p ~/csc/shared/locks; a lock in /tmp could be
# replaced by any other account on the host), so they never run
# together (server memory, decision 8.130): the frequent geometry run skips a
# run while the lock is held (-n); the nightly run and the component map wait
# up to 15 minutes (-w 900) instead of losing their slot.
#
# The database is MongoDB Atlas' free tier: what a cron reads costs bandwidth
# for everyone. The frequent geometry run therefore reads only the snapshots a
# write has marked (derivation_due, decision 8.136); the nightly run checks all
# of them (changes made outside the API, a missed marker) and sweeps.

# Geometry Runner, frequent: frame, shape class, proxies, descriptors,
# complexity and previews of the snapshots marked as due; at most 10 per run
# Runs every 20 minutes
*/20 * * * * source /home/ddu/.bash_profile && flock -n /home/ddu/csc/shared/locks/heavy.lock /home/ddu/csc/current/venv/bin/python /home/ddu/csc/current/backend/main_geometry.py --due --limit 10 >> /home/ddu/csc/shared/logs/geometry_cronjob.$(date +\%F).log 2>&1

# Geometry Runner, nightly: every snapshot is checked (stale ones are derived,
# at most 200); --sweep deletes the previews and deviation maps of snapshots
# that no longer exist (8.121)
# Runs every day at 3:30 AM
30 3 * * * source /home/ddu/.bash_profile && flock -w 900 /home/ddu/csc/shared/locks/heavy.lock /home/ddu/csc/current/venv/bin/python /home/ddu/csc/current/backend/main_geometry.py --limit 200 --sweep >> /home/ddu/csc/shared/logs/geometry_cronjob.$(date +\%F).log 2>&1

# Component Map: precompute PCA + UMAP layouts into component_map_cache
# Runs every day at 4:15 AM
15 4 * * * source /home/ddu/.bash_profile && flock -w 3600 /home/ddu/csc/shared/locks/heavy.lock /home/ddu/csc/current/venv/bin/python /home/ddu/csc/current/backend/main_component_map.py >> /home/ddu/csc/shared/logs/component_map_cronjob.$(date +\%F).log 2>&1

# User Maintenance: clean up unverified user accounts
# Runs every day at 2:00 AM
0 2 * * * source /home/ddu/.bash_profile && /home/ddu/csc/current/venv/bin/python /home/ddu/csc/current/backend/usermaintenance.py >> /home/ddu/csc/shared/logs/usermaintenance_cronjob.$(date +\%F).log 2>&1

# Geometry Maintenance: remove mesh / point-cloud folders of deleted snapshots
# Runs every day at 3:00 AM
0 3 * * * source /home/ddu/.bash_profile && /home/ddu/csc/current/venv/bin/python /home/ddu/csc/current/backend/geometrymaintenance.py >> /home/ddu/csc/shared/logs/geometrymaintenance_cronjob.$(date +\%F).log 2>&1

# Log retention: delete the cron and deploy logs older than 14 days
# Runs every day at 1:30 AM
30 1 * * * find /home/ddu/csc/shared/logs \( -name '*_cronjob.*.log' -o -name 'deploy.*.log' \) -mtime +14 -delete
