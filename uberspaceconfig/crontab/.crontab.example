# CSC 0.6 crontab (paste into `crontab -e` on the server)
# MAILTO applies to every line below it; output is redirected to the logs, so
# cron only mails when a line fails before its redirect (e.g. source fails)
# MAILTO="<maintainer-email>"

# Geometry Runner: frame, shape class, proxies, descriptors, complexity and
# previews of every stale snapshot; at most 25 per run; --sweep deletes the
# previews and deviation maps of snapshots that no longer exist (8.121)
# Runs every 5 minutes
*/5 * * * * source /home/ddu/.bash_profile && flock -n /tmp/geometry.lock /home/ddu/csc/current/venv/bin/python /home/ddu/csc/current/backend/main_geometry.py --limit 25 --sweep >> /home/ddu/csc/shared/logs/geometry_cronjob.log 2>&1

# Component Map: precompute PCA + UMAP layouts into component_map_cache
# Runs every 6 hours
0 */6 * * * source /home/ddu/.bash_profile && flock -n /tmp/component_map.lock /home/ddu/csc/current/venv/bin/python /home/ddu/csc/current/backend/main_component_map.py >> /home/ddu/csc/shared/logs/component_map_cronjob.log 2>&1

# User Maintenance: clean up unverified user accounts
# Runs every day at 2:00 AM
0 2 * * * source /home/ddu/.bash_profile && /home/ddu/csc/current/venv/bin/python /home/ddu/csc/current/backend/usermaintenance.py >> /home/ddu/csc/shared/logs/usermaintenance_cronjob.log 2>&1

# Geometry Maintenance: remove mesh / point-cloud folders of deleted snapshots
# Runs every day at 3:00 AM
0 3 * * * source /home/ddu/.bash_profile && /home/ddu/csc/current/venv/bin/python /home/ddu/csc/current/backend/geometrymaintenance.py >> /home/ddu/csc/shared/logs/geometrymaintenance_cronjob.log 2>&1
