# Supervisor config for CI-built Next.js standalone frontend.
# Copy to ~/etc/services.d/frontend.ini (replaces the npm-run-start config).
#
# Requires a deploy produced by:
#   .github/workflows/frontend-standalone-release.yml
#   + uberspaceconfig/deployment/csc_deploy_frontend_ci.sh
#
# Keep secrets in ~/csc/frontend/.env (Next loads this at startup).
# Required for auth: NEXTAUTH_SECRET, NEXTAUTH_URL, MONGODB_URI, MONGODB_DB,
# MONGODB_USERCOLLECTION, FASTAPI_URL — otherwise /api/auth/* returns 500 HTML
# and the client shows CLIENT_FETCH_ERROR.

[program:frontend]
directory=%(ENV_HOME)s/csc/frontend
command=node server.js
autostart=true
autorestart=true
environment=NODE_ENV=production,PORT=3000,HOSTNAME=0.0.0.0
# `startsecs` is set by Uberspace monitoring team, to prevent a broken service from looping
startsecs=30
