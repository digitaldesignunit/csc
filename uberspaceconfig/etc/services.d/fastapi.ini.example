[program:fastapi]
# ~/csc/current is the active release (csc_release_deploy.sh switches it and restarts)
directory=%(ENV_HOME)s/csc/current/backend
command=%(ENV_HOME)s/csc/current/venv/bin/gunicorn --config %(ENV_HOME)s/csc/current/backend/conf.py
autostart=true
autorestart=true
# `startsecs` is set by Uberspace monitoring team, to prevent a broken service from looping
startsecs=30
environment=
    PYTHONUNBUFFERED="1",
    MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@your.cluster.mongodb.net/csc",
    JWT_SECRET="your-secret",
    JWT_ALGORITHM="HS256",
    JWT_ACCESS_TOKEN_EXPIRE_MINUTES="60",
    GITHUB_REPO_URL="https://github.com/your-org/your-repo",
    # GITHUB_CSC_GH_TOKEN is optional (public repo). Set it only if you need
    # higher GitHub API rate limits for CSC_Update.
    # GITHUB_CSC_GH_TOKEN="",
    SMTP_HOST="yourhost.uberspace.de",
    SMTP_PORT="587",
    SMTP_USER="noreply@yourdomain.com",
    SMTP_PASSWORD="your-password",
    SMTP_FROM_EMAIL="noreply@yourdomain.com",
    SMTP_FROM_NAME="Catalog of Second Chances",
    SMTP_REPLY_TO="support@yourdomain.com",
    SMTP_DEV_MODE="false",
    # server memory (decision 8.130): the gunicorn workers (each loads the
    # geometry libraries: keep it at 2 on Uberspace) and the log level
    CSC_WORKERS="2",
    CSC_LOG_LEVEL="info",
    FRONTEND_URL="https://2ndchances.build",
    # the links of the exports (JSON-LD context, PDF passport) name this API
    # address; without it they use the request's own, which is http:// behind
    # the proxy. Optional.
    CSC_PUBLIC_API_URL="https://api.yourdomain.com",
    # CSC_TRUSTED_PROXIES: the peers whose X-Forwarded-For the rate limits believe
    # (README, "Client addresses and rate limits"). Loopback is right while the web
    # frontend reaches this backend at FASTAPI_URL=http://127.0.0.1:8000; add the
    # server's own address if it goes through the public API host.
    CSC_TRUSTED_PROXIES="127.0.0.0/8,::1",
    CSC_OPEN_REGISTRATION_DOMAINS="tu-darmstadt.de",
    GH_XML_CACHE_DIR="/home/ddu/csc/current/backend/static/ghxml",
    FASTAPI_CORS_ORIGINS="https://yourdomain.com,http://localhost:3000",
    GEOMETRY_UPLOAD_LIMIT_MB="250",
    SNAPSHOT_MESHES_DIR="/home/ddu/csc_assets_private/meshes",
    SNAPSHOT_POINT_CLOUDS_DIR="/home/ddu/csc_assets_private/pointclouds",
    SNAPSHOT_PROXIES_DIR="/home/ddu/csc_assets_private/proxies",
    SNAPSHOT_CAPTURE_DIR="/home/ddu/csc_assets_private/capture",
    EVIDENCE_ATTACHMENTS_DIR="/home/ddu/csc_assets_private/evidence",
    EVIDENCE_UPLOAD_LIMIT_MB="25",
    CSC_GEOMETRY_HEAVY_STAGES="server",
    SNAPSHOT_PREVIEW_DIR="/home/ddu/csc_assets_private/snapshot_previews",
    SNAPSHOT_PHOTOS_DIR="/home/ddu/csc_assets_private/snapshot_photos",
    SNAPSHOT_PHOTO_UPLOAD_LIMIT_MB="10",
    SNAPSHOT_PHOTO_MAX_OUTPUT_MB="2",
    SNAPSHOT_PHOTO_MAX_LONG_EDGE_PX="4096"
    CSC_MIN_CLIENT_VERSIONS="web=0.6.0.0,gh-userobjects=0.6.0.0,geometry-runner=0.6.0.0,catalog-import=0.1",
